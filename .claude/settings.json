{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Skill(.claude/skills/**)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(git show*)",
      "Bash(git config --get*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(echo*)",
      "Bash(pwd)",
      "Bash(which*)",
      "Bash(true)",
      "Bash(false)",
      "Bash(mkdir -p*)",
      "Bash(test*)",
      "Bash(stat*)",
      "Bash(realpath*)",
      "Bash(basename*)",
      "Bash(dirname*)",
      "Bash(node --version)",
      "Bash(node -v)",
      "Bash(npm --version)",
      "Bash(npm -v)",
      "Bash(pnpm --version)",
      "Bash(pnpm -v)",
      "Bash(yarn --version)",
      "Bash(yarn -v)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run check*)",
      "Bash(npm run dev*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(pnpm test*)",
      "Bash(pnpm run test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm tsc*)",
      "Bash(pnpm build*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm check*)",
      "Bash(pnpm check:fix*)",
      "Bash(pnpm run check*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm install*)",
      "Bash(pnpm i)",
      "Bash(pnpm exec*)",
      "Bash(yarn test*)",
      "Bash(yarn lint*)",
      "Bash(yarn typecheck*)",
      "Bash(yarn build*)",
      "Bash(yarn dev*)",
      "Bash(yarn install*)",
      "Bash(npx skills*)",
      "Bash(npx jest*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx biome*)",
      "Bash(npx prettier*)",
      "Bash(npx playwright*)",
      "Bash(node_modules/.bin/jest*)",
      "Bash(node_modules/.bin/vitest*)",
      "Bash(node_modules/.bin/tsc*)",
      "Bash(node_modules/.bin/next*)",
      "Bash(node_modules/.bin/eslint*)",
      "Bash(node_modules/.bin/biome*)",
      "Bash(node_modules/.bin/prettier*)",
      "Bash(node_modules/.bin/playwright*)",
      "Bash(./node_modules/.bin/*)",
      "Bash(uv run*)",
      "Bash(uv pip*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python -m pip*)",
      "Bash(python --version)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs*)",
      "Bash(docker ps)",
      "Bash(docker logs*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh api*)",
      "Monitor",
      "BashOutput",
      "KillShell"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm*)",
      "Bash(mkfs*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*TRUNCATE TABLE*)",
      "Bash(supabase db reset*)",
      "Bash(prisma migrate reset*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(pnpm prisma migrate reset*)",
      "Bash(rails db:reset*)",
      "Edit(.claude/skills/**)",
      "Bash(rm -rf .claude/skills*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js prompt-injection-detector .claude/hooks/prompt-injection-detector.js strict"
          }
        ],
        "description": "Warn when reading sensitive files that may contain injected instructions (strict only)"
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js prompt-injection-detector .claude/hooks/prompt-injection-detector.js strict"
          }
        ],
        "description": "Warn when fetching URLs with suspicious prompt injection patterns (strict only)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js post-edit-accumulator .claude/hooks/post-edit-accumulator.js standard,strict"
          }
        ],
        "description": "Accumulate edited JS/TS/Python paths for batch format+typecheck at Stop"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js context-load-logger .claude/hooks/context-load-logger.js standard,strict"
          }
        ],
        "description": "Log every Skill load to .claude/logs/context-loaded-<session>.log (transcript UI does not show it)"
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "path_glob_match|nested_traversal|include",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js context-load-logger .claude/hooks/context-load-logger.js standard,strict"
          }
        ],
        "description": "Log every lazily-injected rule (paths: glob match) to .claude/logs/context-loaded-<session>.log"
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js context-load-logger .claude/hooks/context-load-logger.js standard,strict"
          }
        ],
        "description": "Agent start marker in the context-load log — InstructionsLoaded events carry no agent name, so rules are attributed by position between markers"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js context-load-logger .claude/hooks/context-load-logger.js standard,strict"
          }
        ],
        "description": "Agent stop marker in the context-load log"
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js session-summary .claude/hooks/session-summary.js standard,strict"
          }
        ],
        "description": "Print session summary (changed files, commits, active tasks) when session ends"
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-with-flags.js stop-format-typecheck .claude/hooks/stop-format-typecheck.js standard,strict"
          }
        ],
        "description": "Batch format (Biome/Prettier/ruff) and typecheck all files edited this session"
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n📋 Claude Agent Workflow — run /caw-status to see all tasks'"
          }
        ]
      }
    ]
  }
}
